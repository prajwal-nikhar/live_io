  "panels": [
    {
      "title": "Active WebSocket Connections",
      "type": "stat",
      "targets": [{ "expr": "active_sockets", "refId": "A" }],
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 }
    },
    {
      "title": "Active Quiz Rooms",
      "type": "stat",
      "targets": [{ "expr": "active_rooms", "refId": "A" }],
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 }
    },
    {
      "title": "Connected Players",
      "type": "stat",
      "targets": [{ "expr": "connected_players", "refId": "A" }],
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 }
    },
    {
      "title": "Memory RSS (Bytes)",
      "type": "stat",
      "targets": [{ "expr": "nodejs_process_resident_memory_bytes", "refId": "A" }],
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 }
    },
    {
      "title": "Join Latency (p95)",
      "type": "timeseries",
      "targets": [{ "expr": "histogram_quantile(0.95, sum(rate(join_latency_seconds_bucket[1m])) by (le))", "refId": "A" }],
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 }
    },
    {
      "title": "Database Query Latency (p95)",
      "type": "timeseries",
      "targets": [{ "expr": "histogram_quantile(0.95, sum(rate(db_latency_seconds_bucket[1m])) by (le))", "refId": "A" }],
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 }
    },
    {
      "title": "CPU Usage",
      "type": "timeseries",
      "targets": [{ "expr": "rate(nodejs_process_cpu_seconds_total[1m]) * 100", "refId": "A" }],
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 }
    },
    {
      "title": "Event Loop Lag",
      "type": "timeseries",
      "targets": [{ "expr": "nodejs_eventloop_lag_seconds", "refId": "A" }],
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 }
    }
  ],
