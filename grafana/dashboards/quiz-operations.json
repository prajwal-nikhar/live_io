{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": null,
  "links": [],
  "liveNow": true,
  "panels": [
    {
      "title": "Active Quizzes & Rooms",
      "type": "stat",
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 0 },
      "targets": [
        { "expr": "active_rooms", "legendFormat": "Active Rooms" },
        { "expr": "quiz_active_total", "legendFormat": "Active Quizzes" }
      ]
    },
    {
      "title": "Connected Players Online",
      "type": "stat",
      "gridPos": { "h": 6, "w": 8, "x": 8, "y": 0 },
      "targets": [
        { "expr": "connected_players", "legendFormat": "Online Players" }
      ]
    },
    {
      "title": "Answers Submitted / sec",
      "type": "stat",
      "gridPos": { "h": 6, "w": 8, "x": 16, "y": 0 },
      "targets": [
        {
          "expr": "rate(quiz_answers_total[1m])",
          "legendFormat": "Answers/sec"
        }
      ]
    },
    {
      "title": "WebSocket Broadcast Latency (s)",
      "type": "timeseries",
      "gridPos": { "h": 10, "w": 12, "x": 0, "y": 6 },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum(rate(broadcast_latency_seconds_bucket[1m])) by (le))",
          "legendFormat": "p99 Broadcast Latency"
        }
      ]
    },
    {
      "title": "Player Join Processing Latency (s)",
      "type": "timeseries",
      "gridPos": { "h": 10, "w": 12, "x": 12, "y": 6 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(join_latency_seconds_bucket[1m])) by (le))",
          "legendFormat": "p95 Join Latency"
        }
      ]
    }
  ],
  "refresh": "5s",
  "schemaVersion": 38,
  "style": "dark",
