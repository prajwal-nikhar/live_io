generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id String @id @default(uuid())

  email        String @unique
  passwordHash String
  name         String

  role String @default("PARTICIPANT")

  isActive   Boolean @default(true)
  isVerified Boolean @default(true)

  lastLogin DateTime?

  refreshTokenHash  String?
  resetTokenHash    String?
  resetTokenExpires DateTime?

  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  quizzes  Quiz[]        @relation("HostQuizzes")
  sessions QuizSession[] @relation("HostSessions")

  @@index([email])
  @@index([role])
  @@index([isActive])
}

model Quiz {
  id String @id @default(uuid())

  title       String
  description String?
  coverImage  String?

  hostId String

  isPublic        String @default("false")
  randomizeOrder  String @default("false")
  negativeMarking String @default("false")

  pointsMultiplier Float @default(1.0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  host User @relation("HostQuizzes", fields: [hostId], references: [id], onDelete: Cascade)

  questions Question[]
  sessions  QuizSession[]

  @@index([hostId])
  @@index([isPublic])
}

model Question {
  id String @id @default(uuid())

  quizId String

  text String

  type String @default("MULTIPLE_CHOICE")

  order Int @default(0)

  points Int @default(100)

  timeLimit Int @default(20)

  imageUrl String?

  explanation String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  quiz Quiz @relation(fields: [quizId], references: [id], onDelete: Cascade)

  options   Option[]
  responses Response[]

  @@index([quizId])
  @@index([order])
}

model Option {
  id String @id @default(uuid())

  questionId String

  text String

  isCorrect String @default("false")

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  responses Response[]

  @@index([questionId])
}

model QuizSession {
  id String @id @default(uuid())

  quizId String

  hostId String

  pin String @unique

  status String @default("LOBBY") // LOBBY, QUESTION_ACTIVE, QUESTION_LOCKED, ANSWER_REVEAL, LEADERBOARD, QUIZ_FINISHED

  currentQuestionIndex Int @default(0)

  currentQuestionId String?

  questionStartTime DateTime?

  questionEndTime DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  quiz Quiz @relation(fields: [quizId], references: [id], onDelete: Cascade)

  host User @relation("HostSessions", fields: [hostId], references: [id], onDelete: Cascade)

  players Player[]

  @@index([pin])
  @@index([quizId])
  @@index([hostId])
  @@index([status])
}

model Player {
  id String @id @default(uuid())

  sessionId String

  name String

  socketId String?

  reconnectToken String @default(uuid())

  score Int @default(0)

  streak Int @default(0)

  isConnected String @default("true")

  lastSeen DateTime @default(now())

  connectionVersion Int @default(1)

  createdAt DateTime @default(now())

  session QuizSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  responses Response[]

  @@unique([sessionId, name])
  @@index([sessionId])
  @@index([socketId])
  @@index([reconnectToken])
  @@index([isConnected])
}

model Response {
  id String @id @default(uuid())

  playerId String

  questionId String

  optionId String?

  textResponse String?

  isCorrect String @default("false")

  pointsEarned Int @default(0)

  responseTimeMs Int @default(0)

  createdAt DateTime @default(now())

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  option Option? @relation(fields: [optionId], references: [id], onDelete: Cascade)

  @@unique([playerId, questionId])
  @@index([playerId])
  @@index([questionId])
  @@index([optionId])
}
